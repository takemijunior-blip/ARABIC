rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all denies access
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable core functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'takemijunior@gmail.com' || request.auth.token.email == 'test@example.com');
    }

    // Entity validation functions
    function isValidUser(user) {
      return user.email is string && user.email.size() <= 200 &&
             user.name is string && user.name.size() <= 200 &&
             user.level is int && user.level >= 1 &&
             user.xp is int && user.xp >= 0 &&
             user.streak is int && user.streak >= 0;
    }

    function isValidLesson(lesson) {
      return lesson.moduleId is string && lesson.moduleId.size() <= 100 &&
             lesson.title is string && lesson.title.size() <= 200 &&
             lesson.order is int &&
             lesson.portuguese is string && lesson.portuguese.size() <= 2000 &&
             lesson.arabic is string && lesson.arabic.size() <= 2000 &&
             lesson.pronunciation is string && lesson.pronunciation.size() <= 2000;
    }

    function isValidExercise(ex) {
      return ex.lessonId is string && ex.lessonId.size() <= 128 &&
             ex.type is string && ex.type.size() <= 100 &&
             ex.question is string && ex.question.size() <= 2000 &&
             ex.correctAnswer is string && ex.correctAnswer.size() <= 2000;
    }

    function isValidChat(chatDoc) {
      return chatDoc.userId is string && chatDoc.userId.size() <= 128 &&
             chatDoc.messages is list && chatDoc.messages.size() <= 200;
    }

    // Collections matches
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'email', 'createdAt'])
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidLesson(request.resource.data);
      allow delete: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidExercise(request.resource.data);
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidChat(request.resource.data);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidChat(request.resource.data);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
